# Copy this file to .env.local and fill in the values. Never commit .env.local.
# None of these may ever get a NEXT_PUBLIC_ prefix (that would send them to the browser).

# EXPA access token. Used only by the sync job (also a GitHub secret). Never put it on Vercel.
EXPA_ACCESS_TOKEN=

# Supabase project address (Project Settings > API). Needed by the sync job and the website.
SUPABASE_URL=

# Read-only key (starts with sb_publishable_). Used by the website (also set on Vercel).
SUPABASE_PUBLISHABLE_KEY=

# Write key (starts with sb_secret_). Used only by the sync job (also a GitHub secret).
SUPABASE_SECRET_KEY=

# Signs the login cookies (random, at least 32 characters). Website only: set it on Vercel too.
# Changing it logs everyone out. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
